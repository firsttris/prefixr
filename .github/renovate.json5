// Renovate (GitHub App, https://github.com/apps/renovate): a pull request for each new release of
// what Prefixr builds on, plus the "Dependency Dashboard" issue listing what is open.
// Only those: the store tools Prefixr downloads at pinned, checksum-verified versions (Legendary,
// gogdl, Nile in src-tauri/src/commands/stores/helpers.rs), the GNOME runtime of the Flatpak
// (manifests, CI image, docs), Flathub's shared-modules, the 7-Zip and cabextract the Flatpak
// builds for winetricks, Bun (CI) and Tauri. Wine/Proton runners, umu-launcher and DXVK/VKD3D are
// fetched by the app at runtime (newest release), so nothing is pinned for them. The other crates
// and packages and the actions are not tracked here. A store tool's sha256 and the Flatpak's
// offline sources cannot be made by Renovate: renovate-pins.yml adds them on the Renovate branch.
// Check with `npx --package renovate renovate-config-validator .github/renovate.json5`.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended"],
  enabledManagers: ["cargo", "bun", "git-submodules", "custom.regex"],
  timezone: "Europe/Berlin",
  labels: ["dependencies"],
  // Nothing merges itself: each of these needs the checks in its pull request read by a person
  automerge: false,
  // flatpak/shared-modules (Renovate leaves submodules alone unless told)
  "git-submodules": {
    enabled: true,
  },
  customManagers: [
    {
      // A store tool: its version and the release URLs of both architectures (the same version,
      // with or without "v"). renovate-pins.yml then sets the sha256 of each URL.
      customType: "regex",
      managerFilePatterns: ["/^src-tauri/src/commands/stores/helpers\\.rs$/"],
      matchStrings: [
        'version: "(?<currentValue>[^"]+)",\\s*assets: &\\[[\\s\\S]*?\\],\\s*source_url: "https://github\\.com/(?<depName>[^"]+)"',
      ],
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>\\d+\\.\\d+\\.\\d+)$",
    },
    {
      // The GNOME runtime: both manifests, the image the Flatpak workflow builds in, the docs and
      // the comment next to the extensions' branch. The image's tags (gnome-50, gnome-51) say
      // which runtimes Flathub's CI images exist for.
      customType: "regex",
      managerFilePatterns: [
        "/^flatpak/(spike/)?[^/]+\\.ya?ml$/",
        "/^\\.github/workflows/flatpak\\.yml$/",
        "/^docs/development\\.md$/",
        "/^src-tauri/src/commands/flatpak_extensions\\.rs$/",
      ],
      matchStrings: [
        'runtime: org\\.gnome\\.Platform\\nruntime-version: "(?<currentValue>\\d+)"',
        "flatpak-github-actions:gnome-(?<currentValue>\\d+)",
        "on the GNOME (?<currentValue>\\d+)\\s+runtime",
        "\\(GNOME (?<currentValue>\\d+)\\), the same as",
      ],
      depNameTemplate: "ghcr.io/flathub-infra/flatpak-github-actions",
      datasourceTemplate: "docker",
      extractVersionTemplate: "^gnome-(?<version>\\d+)$",
      versioningTemplate: "regex:^(?<major>\\d+)$",
    },
    {
      // Git sources of the Flatpak's modules: the tag and the commit it must be
      customType: "regex",
      managerFilePatterns: ["/^flatpak/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "url: https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+?)\\.git\\n\\s+tag: \"?(?<currentValue>[^\"\\n]+)\"?\\n\\s+commit: (?<currentDigest>[0-9a-f]{40})",
      ],
      datasourceTemplate: "github-tags",
      versioningTemplate: "loose",
    },
    {
      // The Bun of the workflows (bun.lock's format and lock-from-bun.py depend on it)
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: ["bun-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "oven-sh/bun",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^bun-v(?<version>.+)$",
    },
  ],
  packageRules: [
    {
      // From the package managers only Tauri (below)
      matchManagers: ["cargo", "bun"],
      enabled: false,
    },
    {
      matchPackageNames: ["Heroic-Games-Launcher/legendary"],
      groupName: "Legendary",
      commitMessageTopic: "Legendary",
      prBodyNotes: [
        "`renovate-pins.yml` sets the sha256 of both downloads on this branch. Before merging: read the release notes (Epic login, `launch --json`, install and uninstall); connect Epic in Settings → Stores with the build of this PR, install a small game, start it and uninstall it. The new version is downloaded on the next connect (one file per version in `helpers/`).",
      ],
    },
    {
      matchPackageNames: ["Heroic-Games-Launcher/heroic-gogdl"],
      groupName: "gogdl",
      commitMessageTopic: "gogdl",
      prBodyNotes: [
        "`renovate-pins.yml` sets the sha256 of both downloads on this branch. Before merging: read the release notes (`auth`, `info`, `download` and its progress lines, which `gog.rs` parses); connect GOG with the build of this PR, install a game with DLCs, start it.",
      ],
    },
    {
      matchPackageNames: ["imLinguin/nile"],
      groupName: "Nile",
      commitMessageTopic: "Nile",
      prBodyNotes: [
        "`renovate-pins.yml` sets the sha256 of both downloads on this branch. Before merging: read the release notes (login, library sync, install, `fuel.json`); connect Amazon Games with the build of this PR, install and start a game.",
      ],
    },
    {
      matchPackageNames: ["ghcr.io/flathub-infra/flatpak-github-actions"],
      groupName: "GNOME runtime",
      commitMessageTopic: "GNOME runtime",
      sourceUrl: "https://github.com/flathub-infra/flatpak-github-actions",
      prBodyNotes: [
        "The manifests, the image of the Flatpak workflow, docs/development.md and the comment in `flatpak_extensions.rs` move together. Before merging: if the new runtime is on a new freedesktop branch, change `26.08` with it by hand (both manifests' `add-extensions`, `EXTENSION_BRANCH` and the gamescope command in `flatpak_extensions.rs`, docs/development.md), and check that `org.freedesktop.Sdk.Extension.node24`, `rust-stable`, `Platform.Compat.i386`, `GL32` and the VulkanLayer extensions (MangoHud, gamescope, vkBasalt) exist for it. The Flatpak workflow of this PR builds the bundle; then start a game with Proton from it.",
      ],
    },
    {
      matchManagers: ["git-submodules"],
      groupName: "Flathub shared-modules",
      commitMessageTopic: "Flathub shared-modules",
      prBodyNotes: [
        "libayatana-appindicator (tray icon) comes from here. The Flatpak workflow of this PR builds it; check the tray icon of the bundle.",
      ],
    },
    {
      matchPackageNames: ["ip7z/7zip", "kyz/libmspack"],
      prBodyNotes: [
        "winetricks uses it in the Flatpak. The Flatpak workflow of this PR builds it; with the bundle, run a winetricks verb that unpacks a cab or 7z (e.g. `vcrun2022`).",
      ],
    },
    {
      matchPackageNames: ["oven-sh/bun"],
      groupName: "Bun",
      sourceUrl: "https://github.com/oven-sh/bun",
      prBodyNotes: [
        "The Bun of CI, the release and the Flatpak workflow's source check (`lock-from-bun.py` reads `bun.lock`). If the source check fails, a new `bun.lock` format may need a change in `flatpak/lock-from-bun.py`.",
      ],
    },
    {
      // Tauri: the crates and the npm packages in one PR, since the CLI wants them on matching
      // versions. Tauri 3 alphas are left out (stable releases only).
      matchManagers: ["cargo", "bun"],
      matchPackageNames: ["tauri", "tauri-build", "tauri-plugin-*", "@tauri-apps/**"],
      enabled: true,
      groupName: "Tauri",
      sourceUrl: "https://github.com/tauri-apps/tauri",
      prBodyNotes: [
        "`renovate-pins.yml` regenerates `package-lock.json`, `flatpak/cargo-sources.json` and `node-sources.json` for the new lock files on this branch (flatpak/update-sources.sh) and starts CI and the Flatpak workflow. Before merging: try the tray, single instance, the dialogs and the remembered window in the AppImage or the bundle.",
      ],
    },
  ],
}
