<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.firsttris.Prefixr</id>
  <name>Prefixr</name>
  <summary>Run Windows games with Wine and Proton</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.firsttris">
    <name>Tristan Teufel</name>
  </developer>
  <description>
    <p>
      Prefixr manages Wine and Proton prefixes for Windows games on Linux: add a game, pick a
      runner, and start it. It downloads Proton-GE, Wine and umu-launcher itself, applies the
      game's protonfixes, and sets up DXVK, MangoHud, Gamescope and GameMode per game.
    </p>
    <ul>
      <li>A library with artwork from SteamGridDB, categories and play time</li>
      <li>Games from Epic Games, GOG and Amazon Games</li>
      <li>Shortcuts for the desktop, the start menu and Steam</li>
      <li>A command line for scripts and AI agents</li>
    </ul>
  </description>
